# =====================================================================
# DroneMission Pro - Variables de entorno (copia este archivo como .env)
# Ningún valor de aquí es una credencial real.
# =====================================================================

# Perfil de base de datos: h2 (sin instalar nada) | postgres
SPRING_PROFILES_ACTIVE=h2

# PostgreSQL (solo si SPRING_PROFILES_ACTIVE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dronemission
DB_USER=dronemission
DB_PASSWORD=cambia-esta-clave

# Seguridad: clave para firmar los JWT (mínimo 32 caracteres) y duración del token
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria-de-32-o-mas-caracteres
JWT_EXPIRATION_MINUTES=480

# Orígenes permitidos por CORS (frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Carpeta donde se guardan las evidencias subidas
STORAGE_PATH=./uploads

# Simulador de telemetría: cada cuántos ms envía una lectura y aceleración del tiempo
SIMULATION_TICK_MS=2000
SIMULATION_TIME_FACTOR=3

# Seguridad (en un servidor público: APP_DEMO_USERS=false, APP_SHOW_RESET_TOKEN=false, H2_CONSOLE_ENABLED=false)
APP_DEMO_USERS=true
APP_REGISTRATION_ENABLED=true
APP_SHOW_RESET_TOKEN=true
H2_CONSOLE_ENABLED=true
APP_MAX_FAILED_ATTEMPTS=5
APP_LOCK_MINUTES=15
APP_AUTH_REQUESTS_PER_MINUTE=20

# Administrador propietario: se crea al arrancar si defines estas variables.
# La contraseña debe tener 8+ caracteres con mayúscula, minúscula y número.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_PASSWORD=
# true = vuelve a poner ADMIN_PASSWORD si olvidaste tu contraseña
ADMIN_RESET_PASSWORD=false
