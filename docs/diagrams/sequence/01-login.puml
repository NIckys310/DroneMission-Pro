@startuml 01-login
!include ../_estilo.iuml
title Secuencia - Iniciar sesión (CU-001)
autonumber
actor Usuario
participant "Frontend\nLoginPage" as FE
participant "AuthController" as C
participant "AuthService" as S
participant "UserRepository" as R
participant "PasswordEncoder\n(BCrypt)" as P
participant "JwtService" as J
participant "AuditService" as A
database "BD" as DB

Usuario -> FE : correo + contraseña
FE -> FE : validar formato (frontend)
FE -> C : POST /api/auth/login
C -> C : @Valid LoginRequest
C -> S : login(request)
S -> R : findByEmailIgnoreCase(correo)
R -> DB : SELECT usuarios
DB --> R : usuario
alt usuario inexistente o contraseña incorrecta
  S -> P : matches(contraseña, hash)
  P --> S : false
  S -> A : logAs(LOGIN_FALLIDO)
  S --> C : AuthenticationFailedException
  C --> FE : 401 "Correo o contraseña incorrectos"
else usuario inactivo
  S --> C : AuthenticationFailedException
  C --> FE : 401 "El usuario está inactivo"
else credenciales válidas
  S -> P : matches(contraseña, hash)
  P --> S : true
  S -> J : generateToken(usuario)
  J --> S : JWT firmado (8 h)
  S -> A : logAs(LOGIN)
  S --> C : LoginResponse(token, usuario, permisos)
  C --> FE : 200 OK
  FE -> FE : guardar token y redirigir al dashboard
end
@enduml
